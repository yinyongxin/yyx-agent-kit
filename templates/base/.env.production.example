# 生产环境变量（复制为 .env.prod，不要提交）
# docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
REDIS_PASSWORD=change_me

# 至少 32 字节
JWT_SECRET=change_me_at_least_32_bytes

# 对外访问地址（OAuth 回调、邮件链接都基于它）
APP_URL=https://example.com
SERVER_PORT=47100

# 网关
GATEWAY_PORT=47180
ADMIN_HOST=admin.example.com
CLIENT_HOST=client.example.com
PORTAL_HOST=portal.example.com

# 首次部署设为 true，初始化默认租户 / 角色 / 权限 / 示例用户（seed 幂等）
SEED_ON_START=false
# 示例用户密码（不设则用 seed 默认 seed_pwd_2026，生产必须改）
SEED_USER_PASSWORD=change_me

# 注意：应用账号 app_rw 的密码在 docker/init-db.sql 中固定为 app_rw_pwd_2026；
# 生产必须同步修改 SQL 与 docker-compose.prod.yml 的 DATABASE_URL。
