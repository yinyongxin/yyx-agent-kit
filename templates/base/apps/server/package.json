{
  "name": "@starter/server",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/server/src/main.js",
    "typecheck": "tsc --noEmit",
    "swagger:export": "tsx scripts/export-openapi.ts",
    "test:e2e": "node test/tenancy-e2e.mjs",
    "test:rls": "node test/rls-concurrency.mjs",
    "test:generated": "tsx test/generated-client.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@nestjs/authentication": "^0.1.7",
    "@nestjs/authorization": "^0.1.4",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^12.6.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/platform-node": "^12.6.0",
    "@nestjs/swagger": "^12.1.3",
    "@nestjs/websockets": "^12.6.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/passport-jwt": "^4.0.1",
    "oxlint": "^1.94.0",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  }
}
