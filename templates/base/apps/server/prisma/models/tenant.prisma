/// 租户。单租户阶段用默认租户（seed 里创建），升级多租户不改业务代码。
model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  slug      String       @unique
  status    TenantStatus @default(active)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users         User[]
  roles         Role[]
  subscriptions Subscription[]

  @@map("tenants")
}
