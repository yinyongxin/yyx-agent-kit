/// 租户文件元数据；实际内容由 FileStorage（默认本地磁盘）保存。
/// tenantId 受 RLS 保护，必须通过 @TenantTx() 访问。
model StoredFile {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  originalName String   @db.VarChar(255)
  storageKey   String   @unique @db.VarChar(255)
  mimeType     String   @db.VarChar(127)
  size         Int
  checksum     String?  @db.VarChar(64)
  uploadedById String?  @db.Uuid
  uploadedBy   User?    @relation("FileUploads", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@index([tenantId, mimeType])
  @@index([uploadedById])
  @@map("files")
}
