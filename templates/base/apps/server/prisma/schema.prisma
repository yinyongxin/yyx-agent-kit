// Prisma schema 主文件 —— 只放 generator / datasource / enum
// 模型按领域拆分到 models/*.prisma，Prisma 自动合并（无需 import）。
// 注意：prisma.config.ts 的 schema 必须指向目录 "prisma"，指向本文件会静默忽略其它模型。
//
// 认证由 NestJS 官方 @nestjs/authentication 实现：用户/角色/认证状态全在本库，不依赖外部 IdP。
// 所有业务表带 tenantId，由 PrismaService extension 自动注入过滤（全局表除外）。

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  active
  suspended
}

enum UserStatus {
  active
  disabled
}

enum SubscriptionStatus {
  active
  canceled
  expired
}

/// 用户在某个租户下的成员状态（多对多关联表字段）。
enum UserTenantStatus {
  active
  suspended
}

/// 平台管理员级别：super 可管理所有租户，ops 为日常运营。
enum PlatformAdminLevel {
  super
  ops
}
