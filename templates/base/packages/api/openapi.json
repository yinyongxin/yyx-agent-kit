  "info": {
    "title": "starter API",
    "description": "starter 模板后端接口（Bearer JWT，多租户路由 /api/t/:tenantId/...）",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "TenantSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "joinedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "joinedAt"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "message": {
            "type": "object",
            "example": "Unauthorized"
          },
          "errorCode": {
            "type": "string",
            "example": "missing_credentials"
          },
          "traceId": {
            "type": "string",
            "example": "4bf92f3577b34da6a3ce929d0e0e4736"
          }
        },
        "required": [
          "statusCode",
          "message"
        ]
      },
      "LogEntryDto": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "example": "2026-11-28T04:06:37.190Z"
          },
          "level": {
            "type": "string",
            "example": "info"
          },
          "message": {
            "type": "string",
            "example": "request completed"
          },
          "traceId": {
            "type": "string",
            "example": "4bf92f3577b34da6a3ce929d0e0e4736"
          },
          "requestId": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "example": "GET"
          },
          "path": {
            "type": "string",
            "example": "/api/tenants"
          },
          "statusCode": {
            "type": "number",
            "example": 200
          },
          "responseTime": {
            "type": "number",
            "example": 12,
            "description": "响应耗时（ms）"
          },
          "raw": {
            "type": "object",
            "description": "完整日志行（已脱敏）"
          }
        },
        "required": [
          "timestamp",
          "level",
          "raw"
        ]
      },
      "LogQueryResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LogEntryDto"
            }
          },
          "total": {
            "type": "number",
            "description": "Loki 无总数；等于已取回条数（用于分页展示）"
          },
          "page": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          },
          "hasMore": {
            "type": "boolean",
            "description": "当前时间窗口内是否还有更多（超出 page*pageSize）"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "pageSize",
          "hasMore"
        ]
      },
      "LogLevelStatsDto": {
        "type": "object",
        "properties": {
          "levels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "counts": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "total": {
            "type": "number"
          }
        },
        "required": [
          "levels",
          "counts",
          "total"
        ]
      },
      "AuditLogDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "tenantId": {
            "type": "string",
            "nullable": true
          },
          "actorUserId": {
            "type": "string",
            "nullable": true
          },
          "actorLabel": {
            "type": "string",
            "nullable": true,
            "example": "admin@example.com"
          },
          "action": {
            "type": "string",
            "example": "tenant.create"
          },
          "resource": {
            "type": "string",
            "example": "tenant"
          },
          "resourceId": {
            "type": "string",
            "nullable": true
          },
          "result": {
            "type": "string",
            "enum": [
              "success",
              "failure"
            ]
          },
          "summary": {
            "type": "string",
            "nullable": true
          },
          "before": {
            "type": "object",
            "nullable": true
          },
          "after": {
            "type": "object",
            "nullable": true
          },
          "ip": {
            "type": "string",
            "nullable": true
          },
          "userAgent": {
            "type": "string",
            "nullable": true
          },
          "traceId": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "action",
          "resource",
          "result",
          "createdAt"
        ]
      },
      "AuditLogListResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditLogDto"
            }
          },
          "total": {
            "type": "number"
          },
          "page": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "pageSize"
        ]
      },
      "SignInDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@example.com",
            "description": "登录邮箱"
          },
          "password": {
            "type": "string",
            "example": "********",
            "description": "登录密码"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SignInResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Bearer access token"
          },
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          }
        },
        "required": [
          "accessToken",
          "tokenType"
        ]
      },
      "MembershipDto": {
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "member"
            ]
          },
          "status": {
            "type": "string",
            "example": "active"
          }
        },
        "required": [
          "tenantId",
          "userId",
          "role",
          "status"
        ]
      },
      "RoleDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "example": "admin"
          },
          "name": {
            "type": "string",
            "example": "管理员"
          }
        },
        "required": [
          "id",
          "code",
          "name"
        ]
      },
      "TenantResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "suspended"
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "status",
          "createdAt",
          "updatedAt"
        ]
      },
      "TenantListResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TenantResponseDto"
            }
          },
          "total": {
            "type": "number"
          },
          "page": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "pageSize"
        ]
      },
      "CreateTenantDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Acme Inc",
            "description": "租户名称"
          },
          "slug": {
            "type": "string",
            "example": "acme",
            "description": "URL slug，创建后不可修改；小写字母、数字、-"
          }
        },
        "required": [
          "name",
          "slug"
        ]
      },
      "UpdateTenantDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Acme Inc",
            "description": "租户名称"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "suspended"
            ]
          }
        }
      }
    }
  }
