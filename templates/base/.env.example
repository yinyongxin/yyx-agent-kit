# 复制为 .env 后按需修改；.env 已加入 .gitignore，不会提交

# 项目标识（docker compose name / 容器名前缀 / 网络名 / volume 名）
COMPOSE_PROJECT_NAME=starter

# PostgreSQL（pgvector）
# 注意：DB 名/用户名用固定 app，避免项目名带连字符导致 PostgreSQL 初始化失败
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_pwd
POSTGRES_PORT=54732

# Redis（认证节的限流用共享存储；业务缓存/会话也用它）
REDIS_PASSWORD=app_redis_pwd
REDIS_PORT=46379

# 后端（应用连库用 service 名，容器外开发用 localhost + 上面映射端口）
# 应用连接必须用非 superuser 账号：superuser 永远绕过 RLS（即使 FORCE），多租户兜底会失效
DATABASE_URL=postgresql://app_rw:app_rw_pwd_2026@localhost:54732/app
# 迁移/建库用 bootstrap superuser（migrate dev 需要 CREATEDB 影子库）；运行时不用它
MIGRATE_DATABASE_URL=postgresql://app:app_dev_pwd@localhost:54732/app
REDIS_URL=redis://:app_redis_pwd@localhost:46379
PORT=47100
# 全站 API 限流（IP + Controller.method 固定窗口）
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_SECONDS=60
# 反向代理信任：true / false / 逗号分隔的地址；默认信任本机与私网代理
TRUST_PROXY=loopback,linklocal,uniquelocal

# ===== 日志（pino）=====
# trace/debug/info/warn/error/fatal/silent；不配时开发 debug、生产 info
LOG_LEVEL=debug
# 是否记录请求/响应体（已脱敏、截断）；开发默认 true，生产默认 false
LOG_HTTP_BODY=true
# 单个 body 日志上限（字符），超出只保留预览
LOG_BODY_LIMIT=16384
# 额外写一份 JSON 日志到文件（相对 apps/server 运行目录）；Alloy 采集它，生产可不配
LOG_FILE=../../logs/app.log
# 文件轮转：daily / hourly；超过大小也切；保留历史文件数（不含当前文件）
LOG_ROTATE_FREQUENCY=daily
LOG_ROTATE_SIZE=50m
LOG_ROTATE_KEEP=7
# Loki 查询地址（docker compose --profile observability 启动后可用）
LOKI_URL=http://localhost:47110
# Loki 里的 service label，需与 Alloy 配置一致
LOG_SERVICE_NAME=starter-api
# 慢 SQL 阈值（ms）；<=0 关闭
SLOW_SQL_MS=100
# 慢 SQL 日志是否带查询参数（参数可能含业务数据，生产默认 false）
SLOW_SQL_LOG_PARAMS=false

# ===== 可观测性（可选 profile：docker compose --profile observability up -d）=====
LOKI_PORT=47110
GRAFANA_PORT=47111
ALLOY_PORT=47112
GRAFANA_USER=admin
GRAFANA_PASSWORD=starter_grafana_2026
# Tempo：trace 存储（Grafana 查看 span 瀑布）
TEMPO_PORT=47113
TEMPO_OTLP_HTTP_PORT=47114
TEMPO_OTLP_GRPC_PORT=47115

# ===== 链路追踪（OTel → Tempo）=====
# 不启用时保持 false / 不配 endpoint；启用后需启动 observability profile
OTEL_ENABLED=true
OTEL_SERVICE_NAME=starter-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:47114
# 开发 100% 采样；生产建议 parentbased_traceidratio + 比例（如 0.1）
OTEL_TRACES_SAMPLER=parentbased_always_on

# ===== NestJS 官方认证/授权包（@nestjs/authentication）=====
# 应用对外地址（OAuth 回调、邮件里的链接都基于它）
APP_URL=http://localhost:47100
# access token 签名密钥（HS256 至少 32 字节；生产务必换成密钥管理里的值）
JWT_SECRET=dev_jwt_secret_change_me_at_least_32_bytes
# 登录失败锁定（Redis；同邮箱+IP 窗口内失败次数 / 窗口秒数 / 锁定时长 / 同 IP 阈值）
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_LOGIN_LOCK_SECONDS=900
AUTH_LOGIN_IP_MAX_ATTEMPTS=30
# 服务端会话（Bearer JWT 的 sid 指向 user_sessions）
AUTH_SESSION_ABSOLUTE_TTL=7d
AUTH_SESSION_IDLE_TTL=1d
AUTH_SESSION_TOUCH_INTERVAL=1m
# 文件上传（本地磁盘驱动；相对进程 cwd，默认 apps/server/storage/files）
FILES_DIR=./storage/files
FILES_MAX_SIZE_MB=20
# Google 登录（可选：不配则不启用 Google OIDC）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 邮件（开发用 LogMailTransport 只打日志；生产填真实 SMTP）
# SMTP_URL=smtp://user:pass@host:587
# 本地演示账号（pnpm --filter @starter/server db:seed:demo）
DEMO_USER_PASSWORD=demo_pwd_2026

# ===== Penpot（独立服务 tools/penpot，不随本 compose 启动）=====
# dev 导航页用以下端口探测外部 Penpot / Mailpit
PENPOT_PORT=9001
PENPOT_MAILPIT_PORT=8025

