# 复制为 .env 后按需修改；.env 已加入 .gitignore，不会提交

# 项目标识（docker compose name / 容器名前缀 / 网络名 / volume 名）
COMPOSE_PROJECT_NAME=starter

# PostgreSQL（pgvector）
# 注意：DB 名/用户名用固定 app，避免项目名带连字符导致 PostgreSQL 初始化失败
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_pwd
POSTGRES_PORT=54732

# Redis（认证节的限流用共享存储；业务缓存/会话也用它）
REDIS_PASSWORD=app_redis_pwd
REDIS_PORT=46379

# 后端（应用连库用 service 名，容器外开发用 localhost + 上面映射端口）
DATABASE_URL=postgresql://app:app_dev_pwd@localhost:54732/app
REDIS_URL=redis://:app_redis_pwd@localhost:46379
PORT=47100

# ===== NestJS 官方认证/授权包（@nestjs/authentication）=====
# 应用对外地址（OAuth 回调、邮件里的链接都基于它）
APP_URL=http://localhost:47100
# access token 签名密钥（HS256 至少 32 字节；生产务必换成密钥管理里的值）
JWT_SECRET=dev_jwt_secret_change_me_at_least_32_bytes
# Google 登录（可选：不配则不启用 Google OIDC）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 邮件（开发用 LogMailTransport 只打日志；生产填真实 SMTP）
# SMTP_URL=smtp://user:pass@host:587
